{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "spontra-max-data-sync",
  "main": "index.ts",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "IBKR_FLEX_QUERY_ID": "1628251"
  },
  "triggers": {
    "crons": [
      "0 6 * * TUE-SAT"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "spontra-max-data-sync-db",
      "database_id": "d93272dc-12ba-4767-a348-afcf44856597",
      "migrations_dir": "./migrations"
    }
  ],
  "account_id": "32ed059d49b57175de6d22f810cb70f9"
}
