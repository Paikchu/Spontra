{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "spontra-analysis",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "limits": { "cpu_ms": 300000 },
  "secrets": { "required": ["DEEPSEEK_API_KEY"] },
  "vars": {
    "SEC_BUSINESS_FLOW_BOOTSTRAP_TICKERS": "ORCL",
    "SEC_DATA_TICKERS": "ORCL,NVDA,MSFT,AAPL,JPM,BRK.B,ADSK,NET",
    "SEC_AI_TICKERS": "ORCL,ADSK,NET",
    "SEC_AI_ENABLED": "true",
    "SEC_DATA_COLLECTION_ENABLED": "true",
    "SEC_USER_AGENT": "earning-report-analysis/1.0 max.zhangyuchen@gmail.com",
    "SEC_ANALYSIS_MODEL": "deepseek-flash",
    "SEC_REASONING_MODEL": "deepseek-flash",
    // Management guidance is enabled; ALPHA_VANTAGE_API_KEY (transcripts) is an optional secret.
    "GUIDANCE_ENABLED": "true",
    "FINDINGS_ENABLED": "true",
    "OPERATING_METRICS_ENABLED": "true",
    "FIGURES_ENABLED": "true",
    "NARRATIVE_ENABLED": "true",
    "GUIDANCE_DECK_SEARCH": "true",
    "GUIDANCE_DAILY_MODEL_CALLS": "40",
    "GUIDANCE_DAILY_TRANSCRIPT_CALLS": "25",
    "TRANSCRIPTS_ENABLED": "true"
  },
  "workflows": [
    {
      "name": "spontra-guidance",
      "binding": "GUIDANCE_WORKFLOW",
      "class_name": "GuidanceWorkflow",
      "concurrency": { "limit": 2 }
    },
    {
      "name": "spontra-business-explainer",
      "binding": "BUSINESS_EXPLAINER_WORKFLOW",
      "class_name": "BusinessExplainerWorkflow",
      "concurrency": { "limit": 1 }
    },
    {
      "name": "spontra-findings",
      "binding": "FINDINGS_WORKFLOW",
      "class_name": "FindingsWorkflow",
      "concurrency": { "limit": 1 }
    },
    {
      "name": "spontra-operating-metrics",
      "binding": "OPERATING_METRICS_WORKFLOW",
      "class_name": "OperatingMetricsWorkflow",
      "concurrency": { "limit": 1 }
    },
    {
      "name": "spontra-business-figures",
      "binding": "FIGURES_WORKFLOW",
      "class_name": "BusinessFiguresWorkflow",
      "concurrency": { "limit": 1 }
    },
    {
      "name": "spontra-business-narrative",
      "binding": "NARRATIVE_WORKFLOW",
      "class_name": "BusinessNarrativeWorkflow",
      "concurrency": { "limit": 1 }
    },
    {
      "name": "earning-report-analysis-sec-analysis",
      "binding": "SEC_ANALYSIS_WORKFLOW",
      "class_name": "SecAnalysisWorkflow",
      "concurrency": {
        "limit": 4
      }
    },
    {
      "name": "earning-report-analysis-sec-memory",
      "binding": "SEC_MEMORY_WORKFLOW",
      "class_name": "SecMemoryWorkflow"
    },
    {
      "name": "earning-report-analysis-company-analysis",
      "binding": "COMPANY_ANALYSIS_WORKFLOW",
      "class_name": "CompanyAnalysisWorkflow",
      "concurrency": {
        "limit": 2
      }
    }
  ],
  "r2_buckets": [
    {
      "binding": "SEC_FILINGS",
      "bucket_name": "earning-report-analysis-sec-filings"
    }
  ],
  // This Worker owns the analysis data model: it is the only writer, and since the read API landed
  // it is also the only reader — the Web Worker no longer binds this database at all. The id is an
  // account-scoped identifier, not a credential, and is committed here the way the bucket and
  // Worker names above are. The database itself is unchanged: same name, same id, same rows.
  //
  // `migrations_dir` moved from `../web/migrations` to this Worker's own directory when ownership
  // moved. The files kept their names, so `d1_migrations` — which records applied migrations by
  // filename — still matches every one of them and nothing is reapplied.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "earning-report-analysis-sec-web",
      "database_id": "3c917a4c-3562-4de1-8b21-586fa384e63f",
      "migrations_dir": "migrations"
    }
  ],
  // Admin login attempts, limited by Cloudflare across isolates. The namespace_id is an
  // account-scoped integer, not a secret.
  "ratelimits": [
    {
      "name": "REPORT_ADMIN_RATE_LIMIT",
      "namespace_id": "1004",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  // TEMPORARY, while the dead scheduled refresh is being diagnosed: every 10 minutes around the
  // clock, so a failed run surfaces within minutes instead of at the next hourly slot. The market
  // windows this replaces cover 09:00-23:00 ET Mon-Fri and must go back once the run is healthy:
  //   "0 13-23 * * 1-5"
  //   "0 0-3 * * 2-6"
  "triggers": {
    "crons": [
      "*/10 * * * *",
      // Bounded deterministic financial-data collection only; does not dispatch AI.
      "*/2 * * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  }
}
