{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "earning-report-analysis-sec-pipeline",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "limits": { "cpu_ms": 300000 },
  "secrets": { "required": ["DEEPSEEK_API_KEY"] },
  "vars": {
    "SEC_USER_AGENT": "earning-report-analysis/1.0 max.zhangyuchen@gmail.com",
    "SEC_ANALYSIS_MODEL": "deepseek-flash",
    "SEC_REASONING_MODEL": "deepseek-flash"
  },
  "workflows": [
    {
      "name": "spontra-research",
      "binding": "RESEARCH_WORKFLOW",
      "class_name": "ResearchWorkflow",
      "concurrency": { "limit": 2 }
    },
    {
      "name": "earning-report-analysis-sec-analysis",
      "binding": "SEC_ANALYSIS_WORKFLOW",
      "class_name": "SecAnalysisWorkflow",
      "concurrency": {
        "limit": 4
      }
    },
    {
      "name": "earning-report-analysis-sec-memory",
      "binding": "SEC_MEMORY_WORKFLOW",
      "class_name": "SecMemoryWorkflow"
    },
    {
      "name": "earning-report-analysis-company-analysis",
      "binding": "COMPANY_ANALYSIS_WORKFLOW",
      "class_name": "CompanyAnalysisWorkflow",
      "concurrency": {
        "limit": 2
      }
    },
    {
      "name": "earning-report-analysis-company-analysis-backfill",
      "binding": "COMPANY_ANALYSIS_BACKFILL_WORKFLOW",
      "class_name": "CompanyAnalysisBackfillWorkflow"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SEC_FILINGS",
      "bucket_name": "earning-report-analysis-sec-filings"
    }
  ],
  // This Worker owns the analysis data model: it is the only writer, and since the read API landed
  // it is also the only reader — the Web Worker no longer binds this database at all. The id is an
  // account-scoped identifier, not a credential, and is committed here the way the bucket and
  // Worker names above are. The database itself is unchanged: same name, same id, same rows.
  //
  // `migrations_dir` moved from `../web/migrations` to this Worker's own directory when ownership
  // moved. The files kept their names, so `d1_migrations` — which records applied migrations by
  // filename — still matches every one of them and nothing is reapplied.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "earning-report-analysis-sec-web",
      "database_id": "3c917a4c-3562-4de1-8b21-586fa384e63f",
      "migrations_dir": "migrations"
    }
  ],
  // Per-credential limit for the read API, enforced by Cloudflare across isolates and colos rather
  // than by a counter in one isolate that would only ever be a local approximation. The
  // namespace_id is an account-scoped integer, not a secret.
  "ratelimits": [
    {
      "name": "ANALYSIS_READ_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 600,
        "period": 60
      }
    }
  ],
  // TEMPORARY, while the dead scheduled refresh is being diagnosed: every 10 minutes around the
  // clock, so a failed run surfaces within minutes instead of at the next hourly slot. The market
  // windows this replaces cover 09:00-23:00 ET Mon-Fri and must go back once the run is healthy:
  //   "0 13-23 * * 1-5"
  //   "0 0-3 * * 2-6"
  "triggers": {
    "crons": [
      // Autonomous research paused at user request. Restore minute cron to resume.
      "*/10 * * * *"
    ]
  },
  "env": {
    "staging": {
      "name": "earning-report-analysis-sec-pipeline-staging",
      "vars": {
        "SEC_USER_AGENT": "earning-report-analysis/1.0 max.zhangyuchen@gmail.com",
        "SEC_ANALYSIS_MODEL": "deepseek-flash",
        "SEC_REASONING_MODEL": "deepseek-flash"
      },
      "workflows": [
        {
          "name": "earning-report-analysis-sec-analysis-staging",
          "binding": "SEC_ANALYSIS_WORKFLOW",
          "class_name": "SecAnalysisWorkflow",
          "concurrency": {
            "limit": 4
          }
        },
        {
          "name": "earning-report-analysis-sec-memory-staging",
          "binding": "SEC_MEMORY_WORKFLOW",
          "class_name": "SecMemoryWorkflow"
        },
        {
          "name": "earning-report-analysis-company-analysis-staging",
          "binding": "COMPANY_ANALYSIS_WORKFLOW",
          "class_name": "CompanyAnalysisWorkflow",
          "concurrency": {
            "limit": 2
          }
        },
        {
          "name": "earning-report-analysis-company-analysis-backfill-staging",
          "binding": "COMPANY_ANALYSIS_BACKFILL_WORKFLOW",
          "class_name": "CompanyAnalysisBackfillWorkflow"
        }
      ],
      "r2_buckets": [
        {
          "binding": "SEC_FILINGS",
          "bucket_name": "earning-report-analysis-sec-filings-staging"
        }
      ],
      // No D1 binding: staging must never touch the production database, and it has no database of
      // its own yet. Its Cron list is empty, so nothing reaches the fundamentals sync on its own; a
      // canary that does gets the explicit "no D1 binding" error instead of a silent wrong write,
      // and the read API answers 503 STORAGE_UNAVAILABLE rather than an empty success. To give
      // staging real read capability, create a staging D1 and add the binding here — never point
      // this environment at the production database id above.
      "ratelimits": [
        {
          "name": "ANALYSIS_READ_RATE_LIMIT",
          "namespace_id": "1003",
          "simple": {
            "limit": 600,
            "period": 60
          }
        }
      ],
      "triggers": { "crons": [] }
    }
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  }
}
