{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "allowImportingTsExtensions": true,
    "types": [
      "@cloudflare/workers-types",
      "node"
    ]
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.tsx",
    "packages/web/**/*.ts",
    "packages/web/**/*.tsx",
    "lib/**/*.ts",
    "shared/**/*.ts",
    "db/**/*.ts",
    "worker/**/*.ts",
    "scripts/**/*.ts",
    "workers/sec-cron/**/*.ts",
    "*.config.ts"
  ],
  "exclude": [
    "node_modules",
    "workers/pipeline",
    "tests/pipeline"
  ]
}
