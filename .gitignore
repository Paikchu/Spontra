# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
.dev.vars*

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.wrangler/
/outputs/
/work/

!workers/pipeline/.dev.vars.example

# desktop workspace build output
/apps/desktop/dist/
/apps/desktop/src-tauri/target/
/apps/desktop/src-tauri/gen/
**/node_modules/

/apps/business-site/dist/
/apps/business-site/.wrangler/

# Marketing website generated assets and local Wrangler state
/apps/marketing/dist/
/apps/marketing/.wrangler/
