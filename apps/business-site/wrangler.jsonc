{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "spontra-business-map",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-08",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/agents/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      { "name": "TELEMETRY", "class_name": "TelemetryStore" }
    ]
  },
  "migrations": [
    { "tag": "telemetry-v1", "new_sqlite_classes": ["TelemetryStore"] }
  ],
  "ratelimits": [
    {
      "name": "PUBLIC_READ_LIMIT",
      "namespace_id": "1002",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    // The stage's door: identities, conversations and socket handshakes per address (docs/stage-agent-design.md §3.3).
    {
      "name": "AGENT_LIMIT",
      "namespace_id": "1005",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  },
  // Reads go to Spontra Analysis's MapReads named entrypoint over a Service Binding. A named
  // entrypoint cannot be reached from the public internet, so the binding is the credential: no
  // key, no public origin, and the main app can be retired without touching this Worker.
  "services": [
    {
      "binding": "SPONTRA_ANALYSIS",
      "service": "spontra-analysis",
      "entrypoint": "MapReads"
    },
    // The stage's door (docs/stage-agent-design.md §3.1): a second binding to the same Worker's StageGateway entrypoint.
    {
      "binding": "SPONTRA_STAGE",
      "service": "spontra-analysis",
      "entrypoint": "StageGateway"
    }
  ],
  "compatibility_flags": [
    "global_fetch_strictly_public"
  ]
}
