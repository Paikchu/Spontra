{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "spontra-business-map",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-08",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "ratelimits": [
    {
      "name": "PUBLIC_READ_LIMIT",
      "namespace_id": "1002",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true
  },
  // Reads go to the analysis pipeline over its Service Binding with this Worker's own read credential
  // (secret EARNING_REPORT_READ_TOKEN, a key listed in the pipeline's ANALYSIS_READ_KEYS). No public
  // origin is involved, so the main app can be retired without touching this Worker.
  "services": [
    {
      "binding": "EARNING_REPORT_PIPELINE",
      "service": "spontra-analysis"
    }
  ],
  "compatibility_flags": [
    "global_fetch_strictly_public"
  ]
}
