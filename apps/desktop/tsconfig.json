{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "types": [
      "vite/client",
      "node"
    ],
    "incremental": false,
    "paths": {
      "@/*": [
        "../../*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "vite.config.ts"
  ],
  "exclude": [
    "src-tauri",
    "dist"
  ]
}
