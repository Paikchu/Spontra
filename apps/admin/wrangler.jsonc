{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "spontra-admin",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-08",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "services": [
    {
      "binding": "SPONTRA_ANALYSIS",
      "service": "spontra-analysis",
      // A named entrypoint is unreachable from the public internet, so the binding is the admin credential.
      "entrypoint": "AdminGateway"
    },
    {
      "binding": "BUSINESS_SITE",
      "service": "spontra-business-map"
    }
  ],
  "observability": {
    "enabled": true
  },
  "compatibility_flags": [
    "global_fetch_strictly_public"
  ]
}
