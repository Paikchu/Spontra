{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  // knip cannot see Cloudflare entrypoints: wrangler.jsonc "main" and Vite HTML inputs are listed here.
  // package.json scripts are picked up automatically.
  "entry": [
    "src/index.ts",
    "web/admin.html",
    "web/preview.html",
    "web/artifact-frame.html",
    "scripts/acceptance/*.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "web/**/*.{ts,tsx}",
    "scripts/**/*.{ts,mjs}"
  ]
}
