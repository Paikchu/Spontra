{
  "name": "spontra",
  "description": "个股业务地图：从公开财报看公司的业务、产品与客户，到收入、成本费用与净利润；含 Spontra Analysis 分析后端与运维后台。",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @spontra/business-site",
    "check": "npm run check:i18n && npm run check:issuer-literals && npm run check:analysis:boundary && npm run typecheck && npm run business-site:typecheck && npm run admin:typecheck && npm run build",
    "build": "npm run check:i18n && npm run check:issuer-literals && npm run business-site:build && npm run admin:build",
    "check:i18n": "node --experimental-strip-types --no-warnings scripts/check-i18n.ts",
    "lint": "eslint . --ignore-pattern dist",
    "typecheck": "tsc --noEmit",
    "deploy:cloudflare": "node --experimental-strip-types scripts/deploy-cloudflare-ci.mjs",
    "analysis:check:migrations": "node --experimental-strip-types workers/analysis/scripts/check-migrations.ts",
    "analysis:check": "wrangler deploy --config workers/analysis/wrangler.jsonc --env=\"\" --dry-run",
    "analysis:migrate:ci": "wrangler d1 migrations apply DB --remote --config workers/analysis/wrangler.jsonc --env=\"\"",
    "analysis:deploy": "npm run analysis:migrate:ci && npm run analysis:check:migrations && wrangler deploy --config workers/analysis/wrangler.jsonc --env=\"\" --keep-vars",
    "analysis:typecheck": "tsc --noEmit -p workers/analysis/tsconfig.json",
    "check:analysis:boundary": "node --experimental-strip-types scripts/check-analysis-boundary.ts",
    "check:issuer-literals": "node --experimental-strip-types --no-warnings scripts/check-issuer-literals.ts",
    "business-site:build": "npm run build --workspace @spontra/business-site",
    "business-site:typecheck": "npm run typecheck --workspace @spontra/business-site",
    "business-site:check": "wrangler deploy --config apps/business-site/wrangler.jsonc --dry-run",
    "admin:dev": "npm run dev --workspace @spontra/admin",
    "admin:build": "npm run build --workspace @spontra/admin",
    "admin:typecheck": "npm run typecheck --workspace @spontra/admin",
    "admin:check": "wrangler deploy --config apps/admin/wrangler.jsonc --dry-run",
    "perf:lab": "node --experimental-strip-types --no-warnings scripts/perf-lab.ts",
    "business-site:build:desktop": "vite build --config apps/business-site/vite.config.ts --mode desktop",
    "desktop:dev": "npm run dev --workspace @spontra/desktop",
    "desktop:build": "npm run build --workspace @spontra/desktop",
    "desktop:perf": "node --experimental-strip-types --no-warnings scripts/perf-desktop.ts",
    "analysis:prepare": "node scripts/prepare-analysis-assets.mjs"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "1.4.0",
    "@earendil-works/chord": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-durable": "1.5.0",
    "@earendil-works/pi-schema": "1.5.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@fontsource-variable/roboto-slab": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@streamdown/cjk": "^1.0.3",
    "agents": "0.33.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.5",
    "d3-scale": "^4.0.2",
    "katex": "^0.18.7",
    "lucide-react": "^1.41.0",
    "motion": "13.1.1",
    "openai": "7.19.0",
    "radix-ui": "^1.6.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shadcn": "^4.21.0",
    "streamdown": "^2.6.0",
    "tw-animate-css": "^1.4.0",
    "unpdf": "1.8.1",
    "zod": "^4.6.5",
    "@tauri-apps/api": "2.12.4",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260830.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/d3-scale": "^4.0.9",
    "@types/katex": "^0.16.8",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.2.1",
    "axe-core": "^4.14.0",
    "eslint": "9.39.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "14.0.0",
    "playwright-core": "1.64.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.3.6",
    "wrangler": "4.127.1",
    "@tauri-apps/cli": "2.12.4",
    "@rolldown/plugin-babel": "0.3.0",
    "@babel/core": "^7.29.0",
    "babel-plugin-react-compiler": "1.0.0",
    "@types/babel__core": "^7.20.5"
  },
  "type": "module",
  "workspaces": [
    "apps/business-site",
    "apps/admin",
    "apps/desktop"
  ]
}
