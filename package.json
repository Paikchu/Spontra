{
  "name": "spontra",
  "description": "个股业务地图：从公开财报看公司的业务、产品与客户，到收入、成本费用与净利润；含 Spontra Analysis 分析后端与运维后台。",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @spontra/business-site",
    "build": "npm run check:i18n && npm run business-site:build && npm run admin:build",
    "check:i18n": "node --experimental-strip-types --no-warnings scripts/check-i18n.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "deploy:cloudflare": "node --experimental-strip-types scripts/deploy-cloudflare-ci.mjs",
    "analysis:check:migrations": "node --experimental-strip-types workers/analysis/scripts/check-migrations.ts",
    "analysis:check": "wrangler deploy --config workers/analysis/wrangler.jsonc --env=\"\" --dry-run",
    "analysis:migrate:ci": "wrangler d1 migrations apply DB --remote --config workers/analysis/wrangler.jsonc --env=\"\"",
    "analysis:deploy": "npm run analysis:migrate:ci && npm run analysis:check:migrations && wrangler deploy --config workers/analysis/wrangler.jsonc --env=\"\" --keep-vars",
    "analysis:typecheck": "tsc --noEmit -p workers/analysis/tsconfig.json && npm run -s test:analysis",
    "test:analysis": "node --experimental-strip-types --no-warnings --test workers/analysis/test/*.test.ts",
    "check:analysis:boundary": "node --experimental-strip-types scripts/check-analysis-boundary.ts",
    "business-site:build": "npm run build --workspace @spontra/business-site",
    "business-site:typecheck": "npm run typecheck --workspace @spontra/business-site",
    "test:business-site": "tsx --tsconfig apps/business-site/tsconfig.json --test apps/business-site/test/*.test.ts",
    "test:web": "tsx --tsconfig tsconfig.json --test packages/web/test/*.test.ts",
    "business-site:check": "wrangler deploy --config apps/business-site/wrangler.jsonc --dry-run",
    "admin:dev": "npm run dev --workspace @spontra/admin",
    "admin:build": "npm run build --workspace @spontra/admin",
    "admin:typecheck": "npm run typecheck --workspace @spontra/admin",
    "admin:check": "wrangler deploy --config apps/admin/wrangler.jsonc --dry-run",
    "test:admin": "node --experimental-strip-types --no-warnings --test apps/admin/test/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@cloudflare/puppeteer": "1.4.0",
    "@streamdown/cjk": "^1.0.3",
    "agents": "0.27.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.5",
    "d3-scale": "^4.0.2",
    "katex": "^0.18.7",
    "lucide-react": "^1.41.0",
    "motion": "13.1.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shadcn": "^4.21.0",
    "streamdown": "^2.6.0",
    "tw-animate-css": "^1.4.0",
    "unpdf": "1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260830.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/d3-scale": "^4.0.9",
    "@types/katex": "^0.16.8",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "axe-core": "^4.14.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "playwright-core": "1.64.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.127.1"
  },
  "type": "module",
  "workspaces": [
    "apps/business-site",
    "apps/admin"
  ]
}
