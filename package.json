{
  "name": "investment-record",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run test:unit && npm run test:pipeline && npm run build && npm run test:rendered",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "snapshot:update": "node --experimental-strip-types scripts/update-site-data.ts",
    "ibkr:flex:fetch": "node --experimental-strip-types scripts/fetch-ibkr-flex.ts",
    "earnings:update": "node --experimental-strip-types scripts/update-earnings-calendar.ts",
    "symbols:update": "node --experimental-strip-types scripts/update-symbol-directory.ts",
    "review:check": "node --experimental-strip-types scripts/validate-daily-portfolio-review.ts",
    "macro:check": "node --experimental-strip-types scripts/validate-macro-dashboard.ts",
    "market-close:build": "node --experimental-strip-types scripts/build-market-close-briefs.ts",
    "market-close:check": "node --experimental-strip-types scripts/validate-market-close-briefs.ts",
    "db:generate": "drizzle-kit generate",
    "sec-cron:check": "wrangler deploy --config workers/sec-cron/wrangler.jsonc --dry-run",
    "sec-cron:deploy": "env -u WRANGLER_CI_OVERRIDE_NAME -u WRANGLER_CI_MATCH_TAG wrangler deploy --config workers/sec-cron/wrangler.jsonc --name max-investment-record-sec-cron --keep-vars",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote --config wrangler.jsonc",
    "deploy:cloudflare": "npm run db:migrate:remote && wrangler deploy --config dist/server/wrangler.json --keep-vars && npm run sec-cron:deploy",
    "test:earning-report": "node --experimental-strip-types --test tests/earning-report-integration.test.ts tests/earning-report-rich-text.test.ts",
    "worker:pipeline:check:migrations": "node --experimental-strip-types workers/pipeline/scripts/check-migrations.ts",
    "worker:pipeline:check": "wrangler deploy --config workers/pipeline/wrangler.jsonc --env=\"\" --dry-run",
    "worker:pipeline:migrate:ci": "wrangler d1 migrations apply DB --remote --config workers/pipeline/wrangler.jsonc --env=\"\"",
    "worker:pipeline:deploy": "npm run worker:pipeline:migrate:ci && npm run worker:pipeline:check:migrations && wrangler deploy --config workers/pipeline/wrangler.jsonc --env=\"\" --keep-vars",
    "worker:pipeline:version": "wrangler versions upload --config workers/pipeline/wrangler.jsonc --env=\"\" --keep-vars",
    "worker:pipeline:deploy:staging": "wrangler deploy --config workers/pipeline/wrangler.jsonc --env staging --keep-vars",
    "worker:pipeline:version:staging": "wrangler versions upload --config workers/pipeline/wrangler.jsonc --env staging --keep-vars",
    "worker:pipeline:db:generate": "drizzle-kit generate --config workers/pipeline/drizzle.config.ts",
    "typecheck:pipeline": "tsc --noEmit -p workers/pipeline/tsconfig.json",
    "test:pipeline": "node --experimental-strip-types --test tests/pipeline/*.test.ts",
    "check:pipeline:boundary": "node --experimental-strip-types scripts/check-pipeline-boundary.ts",
    "test:unit": "tsx --tsconfig tsconfig.test.json --test tests/*.test.ts tests/*.test.tsx",
    "test:rendered": "node --test tests/rendered-html.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@streamdown/cjk": "^1.0.3",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.5",
    "d3-scale": "^4.0.2",
    "drizzle-orm": "0.45.2",
    "katex": "^0.18.7",
    "lucide-react": "^1.41.0",
    "motion": "13.1.1",
    "next": "16.2.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shadcn": "^4.21.0",
    "streamdown": "^2.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.2",
    "@cloudflare/workers-types": "5.20260830.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/d3-scale": "^4.0.9",
    "@types/katex": "^0.16.8",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.127.1"
  },
  "type": "module"
}
