{
  "name": "spontra",
  "description": "Spontra Analysis 单 Worker 财报分析后端、运维后台与 iOS 只读 API 网关（含内部报告预览）。",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npx wrangler dev --config wrangler.jsonc",
    "dev:web": "vite --config vite.config.ts",
    "prepare:assets": "node scripts/checks/prepare-analysis-assets.mjs",
    "build:web": "vite build --config vite.config.ts",
    "build": "npm run prepare:assets && npm run check:i18n && npm run check:issuer-literals && npm run build:web",
    "check:i18n": "node --experimental-strip-types --no-warnings scripts/checks/check-i18n.ts",
    "check:issuer-literals": "node --experimental-strip-types --no-warnings scripts/checks/check-issuer-literals.ts",
    "check:boundary": "node --experimental-strip-types scripts/checks/check-analysis-boundary.ts",
    "check:migrations": "node --experimental-strip-types scripts/checks/check-migrations.ts",
    "typecheck:worker": "tsc --noEmit -p tsconfig.worker.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.json",
    "typecheck": "npm run typecheck:worker && npm run typecheck:web && npm run typecheck:scripts",
    "check": "npm run check:i18n && npm run check:issuer-literals && npm run check:boundary && npm run typecheck && npm run build && npm run deploy:dry-run",
    "lint": "eslint . --ignore-pattern dist",
    "migrate:ci": "wrangler d1 migrations apply DB --remote --config wrangler.jsonc --env=\"\"",
    "deploy:dry-run": "wrangler deploy --config wrangler.jsonc --env=\"\" --dry-run",
    "deploy": "npm run migrate:ci && npm run check:migrations && wrangler deploy --config wrangler.jsonc --env=\"\"",
    "analysis:prepare": "npm run prepare:assets",
    "analysis:check:migrations": "npm run check:migrations",
    "analysis:check": "npm run deploy:dry-run",
    "analysis:typecheck": "npm run typecheck:worker",
    "analysis:migrate:ci": "npm run migrate:ci",
    "analysis:deploy": "npm run deploy",
    "check:analysis:boundary": "npm run check:boundary"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "1.4.0",
    "@earendil-works/chord": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-durable": "1.5.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "agents": "0.33.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.5",
    "fflate": "0.8.3",
    "lucide-react": "^1.41.0",
    "openai": "7.19.0",
    "radix-ui": "^1.6.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.11.2",
    "reicon-react": "^1.2.6",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "unpdf": "1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260830.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.2.1",
    "axe-core": "^4.14.0",
    "eslint": "9.39.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "14.0.0",
    "playwright-core": "1.64.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.3.6",
    "wrangler": "4.127.1"
  },
  "type": "module"
}
